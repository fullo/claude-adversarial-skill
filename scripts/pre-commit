#!/bin/sh
# Pre-commit hook: run the repository invariant checks on exactly what is staged.
# Install once: ln -s ../../scripts/pre-commit .git/hooks/pre-commit
# (on Windows, Git for Windows runs this file with its own sh; copy it instead of linking)
# --strict fails if no private terms are configured (see scripts/check.py).
root="$(git rev-parse --show-toplevel)" || exit 1
py=python3
command -v "$py" >/dev/null 2>&1 || py=python
"$py" -I "$root/scripts/check.py" --strict --staged --root "$root" || exit 1
# Eval facts: only when the staged change touches the evals, and on exactly the staged files.
# Fact files are code: review them like any other code before committing.
if git diff --cached --name-only | grep -q '^skills/adversarial-verify/evals/'; then
  tmp="$(mktemp -d)" || exit 1
  git checkout-index -a --prefix="$tmp/" || { rm -rf "$tmp"; exit 1; }
  out="$("$py" -I "$root/scripts/check_facts.py" --root "$tmp")"; rc=$?
  rm -rf "$tmp"
  [ $rc -eq 0 ] || { printf "%s\n" "$out"; exit 1; }
fi
